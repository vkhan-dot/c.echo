# Centras.Echo — Environment Variables

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/centras_echo?sslmode=require

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars

# ─── Google OAuth (создать на console.cloud.google.com) ───────────────────────
# 1. Создайте проект → APIs & Services → Credentials → OAuth 2.0 Client ID
# 2. Application type: Web application
# 3. Authorized redirect URIs: https://api.centras-echo.railway.app/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://api.centras-echo.railway.app/api/auth/google/callback
# Разрешенные почтовые домены для авторегистрации через запятую (например: centras.kz,company.com)
ALLOWED_DOMAINS=

# ─── LiveKit Self-Hosted ──────────────────────────────────────────────────────
# LiveKit сервис деплоится отдельно на Railway из образа livekit/livekit-server
LIVEKIT_URL=http://localhost:7880
# Публичный адрес LiveKit для веб-клиента. Если не задан, используется LIVEKIT_URL.
# В Railway LIVEKIT_URL указывает на внутренний ws:// адрес, а PUBLIC_LIVEKIT_URL — на внешний wss://
PUBLIC_LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-minimum-32-characters-long

# Railway API service overrides:
# LIVEKIT_URL=http://livekit.railway.internal:8080
# PUBLIC_LIVEKIT_URL=wss://livekit.centras-echo.railway.app
# LIVEKIT_API_KEY=<same as LiveKit service>
# LIVEKIT_API_SECRET=<same as LiveKit service>

# Railway LiveKit service overrides:
# LIVEKIT_TCP_PROXY_HOST=<your Railway TCP Proxy host, e.g. example.proxy.rlwy.net>
# RAILWAY_TCP_PROXY_DOMAIN=<Railway TCP Proxy host; accepted alias>
# LIVEKIT_NODE_IP=<optional manual override; usually resolved from LIVEKIT_TCP_PROXY_HOST>
# LIVEKIT_TCP_PORT=<Railway TCP Proxy public port>
# RAILWAY_TCP_PROXY_PORT=<Railway TCP Proxy public port; accepted alias>
# RAILWAY_PROXY_TARGET_PORT=<Railway TCP Proxy target port>
# RAILWAY_TCP_APPLICATION_PORT=<Railway TCP Proxy target port; accepted alias>

# ─── Gemini AI ────────────────────────────────────────────────────────────────
# Получить на: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# ─── App URLs ─────────────────────────────────────────────────────────────────
FRONTEND_URL=https://centras-echo.railway.app
CORS_ORIGIN=https://centras-echo.railway.app
PORT=3001
LOG_LEVEL=info
NODE_ENV=production

# ─── Audio Storage (Railway Volume) ───────────────────────────────────────────
# Railway Volume монтируется автоматически через railway.toml
# Путь /data/audio уже прописан в Dockerfile
AUDIO_STORAGE_PATH=/data/audio
